{
  "name": "@taiwei/tyme4ts-almanac",
  "version": "0.1.0",
  "description": "基于 tyme4ts 公共 API 的可溯源公共通书扩展",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "tyme4ts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "sideEffects": false
}
